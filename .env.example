# Vercel / Next.js Environment
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
UPLOADTHING_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
OWLSIDE_SERVER_SECRET=

# Convex Deployment Environment (set via `npx convex env set KEY VALUE`)
# OWLSIDE_SERVER_SECRET= # Same private value as Next.js. Use a randomly generated 32-byte secret.
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=
# GMAIL_SMTP_FALLBACK_USER=
# GMAIL_SMTP_FALLBACK_APP_PASSWORD=
# OWLSIDE_ALLOW_DEV_OTP_LOG=true
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY= # Same value as Next.js, also required in the Convex deployment.
# VAPID_SUBJECT=mailto:maintainer@students.kennesaw.edu
# OWLSIDE_MAINTAINER_EMAILS=
# V2 Incident posting requires both switches and two eligible appointed Moderators.
# OWLSIDE_V2_INCIDENT_POSTING=false
# OWLSIDE_V2_MODERATOR_OPS_COMPLETE=false
# Enable only after private UploadThing ACLs and the photo-review workflow are verified.
# OWLSIDE_V2_INCIDENT_PHOTOS=false
# OWLSIDE_V2_DB_IO_SAMPLE=
# Official Alert copy (ADR-0007, #80): off (links-only) → shadow (14-day hidden poll) → display.
# OWLSIDE_ALERT_COPY_MODE=off
# OWLSIDE_ALERT_PUSH=false
# Hackathon only: shorten the required shadow window (hours, minimum 1). Unset = 14 days.
# OWLSIDE_ALERT_SHADOW_HOURS=
